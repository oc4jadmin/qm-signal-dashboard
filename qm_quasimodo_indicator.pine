//@version=5
// =============================================================================
//  QM — Quasimodo (Over & Under) — QM Master (CLEAN)
//  Rujukan: "teknik-forex Quasimodo" (QM Master) & "Quasimodo Pattern PDF Guide"
//
//  CARA BACA (paling ringkas):
//    • GARIS TEBAL  = QML = LEVEL ENTRY (aras bahu kiri).
//    • Label "SELL @ QML" / "BUY @ QML" muncul HANYA bila harga sentuh QML.
//    • Panel kanan atas = Entry / SL / TP1 / TP2 / RR.
//    • Label 2·LS 3·Neck 4·Over 5·Under = struktur (boleh dimatikan).
//
//  Default dibuat minimal supaya chart tak serabut. Hiasan lain opt-in.
// =============================================================================
indicator("QM — Quasimodo (Over & Under) — QM Master", "Quasimodo QM",
     overlay=true, max_lines_count=500, max_labels_count=500)

// ──────────────────────────── INPUT ────────────────────────────
grpP = "1. Pivot / Struktur"
pivLen     = input.int(3,  "Pivot lookback (kiri/kanan)", minval=1, group=grpP,
     tooltip="Makin besar = makin sedikit & makin besar swing. M5 crude oil: cuba 5-8.")
armMaxBars = input.int(40, "Maks bar menunggu retrace (expiry)", minval=5, group=grpP)
minBarGap  = input.int(15, "Min bar antara setup baru", minval=1, group=grpP,
     tooltip="Elak setup bertindih pada jarak bar yang terlalu rapat.")
dedupeATR  = input.float(0.50, "Elak QML berulang (× ATR)", minval=0.0, step=0.05, group=grpP,
     tooltip="Kalau QML baru hampir sama dengan QML setup terakhir, ia diabaikan. 0 = matikan.")

grpC = "2. Confluence (QML = MPL)"
useConfluence = input.bool(true, "Deteksi confluence QML = MPL", group=grpC)
confluenceTol = input.float(0.30, "Toleransi confluence (× ATR)", minval=0.0, step=0.05, group=grpC)

grpB = "3. Bullish QM"
showBull  = input.bool(true, "Tampilkan bullish QM (BUY)", group=grpB)
bullColor = input.color(color.teal, "Warna bullish", group=grpB)

grpS = "4. Bearish QM"
showBear  = input.bool(true, "Tampilkan bearish QM (SELL)", group=grpS)
bearColor = input.color(color.red, "Warna bearish", group=grpS)

grpD = "5. Tampilan"
showQML    = input.bool(true,  "QML (garis entry tebal)", group=grpD)
showEntry  = input.bool(true,  "Label entry SELL/BUY @ QML", group=grpD)
showPanel  = input.bool(true,  "Panel Entry / SL / TP", group=grpD)
maxSetups  = input.int(1, "Bilangan setup disimpan", minval=1, maxval=10, group=grpD,
     tooltip="1 = hanya setup aktif. Naikkan untuk lihat sejarah.")
extendLines = input.bool(true, "Panjangkan QML ke kanan", group=grpD)

grpTP = "6. Take Profit"
showTPLines = input.bool(true,  "Garisan putus-putus TP1 (Neck) & TP2 (Under)", group=grpTP)
tp1Color    = input.color(color.new(#2962FF, 20), "Warna TP1", group=grpTP)
tp2Color    = input.color(color.new(#9C27B0, 20), "Warna TP2", group=grpTP)

showFiboTP = input.bool(false, "Fibo TP (unjuran impulse QM)", group=grpTP,
     tooltip="Unjur level fibo dari range impulse (Head–Under), diukur dari QML. Untuk SELL: QML − range×ratio. Untuk BUY: QML + range×ratio.")
fibStr     = input.string("0.5, 0.618, 1.0, 1.272, 1.618", "Fibo levels", group=grpTP,
     tooltip="Senarai ratio dipisah koma.")
fibColor   = input.color(color.new(color.orange, 30), "Warna Fibo TP", group=grpTP)
fibLabels  = input.bool(true, "Label level fibo", group=grpTP)

grpA = "7. Hiasan (off secara default)"
showNeck   = input.bool(false, "Level leher", group=grpA)
showHead   = input.bool(false, "Level head (SL)", group=grpA)
showUnder  = input.bool(false, "Level under", group=grpA)
showStruct = input.bool(false, "Label struktur 2·LS / 3·Neck / 4·Over / 5·Under", group=grpA)
showTP     = input.bool(false, "Label TP1 / TP2 pada saat entry", group=grpA)
showZig    = input.bool(false, "Zigzag + label HH/HL/LH/LL", group=grpA)
zigColor   = input.color(color.new(color.gray, 30), "Warna zigzag", group=grpA)
zigKeep    = input.int(40, "Bilangan swing dilukis", minval=10, maxval=200, group=grpA)

// ───────────────────────── ZIGZAG PIVOTS ─────────────────────────
var float[] zPrice = array.new_float()
var int[]   zBar   = array.new_int()
var int[]   zType  = array.new_int()   // 1 = pivot high, -1 = pivot low

var array<line>  zzLines  = array.new_line()
var array<label> zzLabels = array.new_label()

drawLeg(int pi, int ni) =>
    array.push(zzLines, line.new(array.get(zBar, pi), array.get(zPrice, pi),
                                 array.get(zBar, ni), array.get(zPrice, ni),
                                 xloc=xloc.bar_index, color=color.new(zigColor, 0), width=1))
    string txt = array.get(zType, pi) == 1 ? "H" : "L"
    if pi - 1 >= 0
        if array.get(zType, pi) == 1
            txt := array.get(zPrice, pi) > array.get(zPrice, pi - 1) ? "HH" : "LH"
        else
            txt := array.get(zPrice, pi) < array.get(zPrice, pi - 1) ? "LL" : "HL"
    array.push(zzLabels, label.new(array.get(zBar, pi), array.get(zPrice, pi), txt,
                                   style=label.style_none, textcolor=zigColor, size=size.tiny))
    while array.size(zzLines) > zigKeep
        line.delete(array.shift(zzLines))
    while array.size(zzLabels) > zigKeep
        label.delete(array.shift(zzLabels))

ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low,  pivLen, pivLen)

if not na(ph)
    int pb = bar_index - pivLen
    if array.size(zType) == 0
        array.push(zPrice, ph)
        array.push(zBar, pb)
        array.push(zType, 1)
    else if array.last(zType) == 1
        if ph >= array.last(zPrice)
            array.set(zPrice, array.size(zPrice) - 1, ph)
            array.set(zBar,   array.size(zBar)   - 1, pb)
    else
        array.push(zPrice, ph)
        array.push(zBar, pb)
        array.push(zType, 1)
        if showZig and array.size(zType) >= 2
            drawLeg(array.size(zType) - 2, array.size(zType) - 1)

if not na(pl)
    int pb = bar_index - pivLen
    if array.size(zType) == 0
        array.push(zPrice, pl)
        array.push(zBar, pb)
        array.push(zType, -1)
    else if array.last(zType) == -1
        if pl <= array.last(zPrice)
            array.set(zPrice, array.size(zPrice) - 1, pl)
            array.set(zBar,   array.size(zBar)   - 1, pb)
    else
        array.push(zPrice, pl)
        array.push(zBar, pb)
        array.push(zType, -1)
        if showZig and array.size(zType) >= 2
            drawLeg(array.size(zType) - 2, array.size(zType) - 1)

while array.size(zType) > 60
    array.shift(zPrice)
    array.shift(zBar)
    array.shift(zType)

// ─────────────────── DETEKSI STRUKTUR (4 pivot) ───────────────────
bool newStructure = false
int ndir = 0            // 1 = bearish SELL, -1 = bullish BUY
float nqml = na
float nneck = na
float nhead = na
float nunder = na
int nlsBar = na
int nneckBar = na
int nheadBar = na
int nunderBar = na

if array.size(zType) >= 4
    int n = array.size(zType)
    int   t0 = array.get(zType, n - 4)
    int   t1 = array.get(zType, n - 3)
    int   t2 = array.get(zType, n - 2)
    int   t3 = array.get(zType, n - 1)
    float p0 = array.get(zPrice, n - 4)
    float p1 = array.get(zPrice, n - 3)
    float p2 = array.get(zPrice, n - 2)
    float p3 = array.get(zPrice, n - 1)
    int   b0 = array.get(zBar, n - 4)
    int   b1 = array.get(zBar, n - 3)
    int   b2 = array.get(zBar, n - 2)
    int   b3 = array.get(zBar, n - 1)

    if t0 == 1 and t1 == -1 and t2 == 1 and t3 == -1 and showBear
        if p2 > p0 and p3 < p1          // Over (head > LS) & Under (low < neck)
            newStructure := true
            ndir := 1
            nqml := p0
            nneck := p1
            nhead := p2
            nunder := p3
            nlsBar := b0
            nneckBar := b1
            nheadBar := b2
            nunderBar := b3
    else if t0 == -1 and t1 == 1 and t2 == -1 and t3 == 1 and showBull
        if p2 < p0 and p3 > p1          // Over (head < LS) & Under (high > neck)
            newStructure := true
            ndir := -1
            nqml := p0
            nneck := p1
            nhead := p2
            nunder := p3
            nlsBar := b0
            nneckBar := b1
            nheadBar := b2
            nunderBar := b3

// ───────────────────── STATE PERSISTEN ─────────────────────
float atr = ta.atr(14)

var bool armed = false
var int armTime = na
var int armUnderBar = na
var int armDir = 0
var float armQML = na
var float armNeck = na
var float armHead = na
var float armUnder = na
var bool armConfluence = false
var int lastDoneUnder = na
var float lastQML = na
var int lastArmBar = na

var float[] qmlHist = array.new_float()

extB = extendLines ? extend.right : extend.none

// ───────────── OBJEK GAMBAR: simpan setup terakhir ─────────────
var array<line>  allLines  = array.new_line()
var array<label> allLabels = array.new_label()
var array<int>   setLineCounts  = array.new_int()
var array<int>   setLabelCounts = array.new_int()

pruneSets() =>
    while array.size(setLineCounts) > maxSetups
        int ln = array.get(setLineCounts, 0)
        if ln > 0
            for i = 0 to ln - 1
                line.delete(array.shift(allLines))
        array.shift(setLineCounts)
        int lb = array.get(setLabelCounts, 0)
        if lb > 0
            for i = 0 to lb - 1
                label.delete(array.shift(allLabels))
        array.shift(setLabelCounts)

// ─────────────────── ARM STRUKTUR BARU ───────────────────
bool isNewUnder = na(lastDoneUnder) or nunderBar > lastDoneUnder

bool tooSoon  = not na(lastArmBar) and (bar_index - lastArmBar) < minBarGap
bool tooClose = dedupeATR > 0 and not na(lastQML) and math.abs(nqml - lastQML) <= atr * dedupeATR

if newStructure and not armed and isNewUnder and not tooSoon and not tooClose
    armed        := true
    armTime      := bar_index
    armUnderBar  := nunderBar
    armDir       := ndir
    armQML       := nqml
    armNeck      := nneck
    armHead      := nhead
    armUnder     := nunder
    lastArmBar   := bar_index

    // --- confluence QML = MPL (look to the left) ---
    armConfluence := false
    if useConfluence
        float tol = atr * confluenceTol
        int hsz = array.size(qmlHist)
        if hsz > 0
            for i = 0 to hsz - 1
                if math.abs(nqml - array.get(qmlHist, i)) <= tol
                    armConfluence := true

    int lineStart  = array.size(allLines)
    int labelStart = array.size(allLabels)

    color cQML  = armConfluence ? color.orange : (ndir == 1 ? bearColor : bullColor)
    color cBase = ndir == 1 ? bearColor : bullColor

    if showStruct
        if ndir == 1
            array.push(allLabels, label.new(nlsBar, nqml, "2·LS", style=label.style_label_down, color=color.new(bearColor, 15), textcolor=color.white, size=size.tiny))
            array.push(allLabels, label.new(nneckBar, nneck, "3·Neck", style=label.style_label_up, color=color.new(bearColor, 15), textcolor=color.white, size=size.tiny))
            array.push(allLabels, label.new(nheadBar, nhead, "4·Over", style=label.style_label_down, color=color.new(bearColor, 15), textcolor=color.white, size=size.tiny))
            array.push(allLabels, label.new(nunderBar, nunder, "5·Under", style=label.style_label_up, color=color.new(bearColor, 15), textcolor=color.white, size=size.tiny))
        else
            array.push(allLabels, label.new(nlsBar, nqml, "2·LS", style=label.style_label_up, color=color.new(bullColor, 15), textcolor=color.white, size=size.tiny))
            array.push(allLabels, label.new(nneckBar, nneck, "3·Neck", style=label.style_label_down, color=color.new(bullColor, 15), textcolor=color.white, size=size.tiny))
            array.push(allLabels, label.new(nheadBar, nhead, "4·Over", style=label.style_label_up, color=color.new(bullColor, 15), textcolor=color.white, size=size.tiny))
            array.push(allLabels, label.new(nunderBar, nunder, "5·Under", style=label.style_label_down, color=color.new(bullColor, 15), textcolor=color.white, size=size.tiny))

    // QML dilukis dari bar bahu kiri — "look to the left"
    if showQML
        array.push(allLines, line.new(nlsBar, nqml, bar_index + 1, nqml, extend=extB, color=cQML, style=line.style_solid, width=2))
        array.push(allLabels, label.new(bar_index, nqml,
             (ndir == 1 ? "SELL " : "BUY ") + str.tostring(nqml, format.mintick),
             style=label.style_label_left, color=cQML, textcolor=color.white, size=size.small))
    if showNeck
        array.push(allLines, line.new(nneckBar, nneck, bar_index + 1, nneck, extend=extB, color=color.new(cBase, 55), style=line.style_dashed, width=1))
    if showHead
        array.push(allLines, line.new(nheadBar, nhead, bar_index + 1, nhead, extend=extB, color=color.new(cBase, 30), style=line.style_dotted, width=1))
    if showUnder
        array.push(allLines, line.new(nunderBar, nunder, bar_index + 1, nunder, extend=extB, color=color.new(cBase, 55), style=line.style_dashed, width=1))

    // ── TP1 (Neck) & TP2 (Under) sebagai garisan putus-putus ──
    if showTPLines
        array.push(allLines, line.new(nneckBar, nneck, bar_index + 1, nneck, extend=extB, color=tp1Color, style=line.style_dashed, width=1))
        array.push(allLabels, label.new(bar_index, nneck, "TP1", style=label.style_label_left, color=color.new(tp1Color, 0), textcolor=color.white, size=size.tiny))
        array.push(allLines, line.new(nunderBar, nunder, bar_index + 1, nunder, extend=extB, color=tp2Color, style=line.style_dashed, width=1))
        array.push(allLabels, label.new(bar_index, nunder, "TP2", style=label.style_label_left, color=color.new(tp2Color, 0), textcolor=color.white, size=size.tiny))

    // ── Fibo TP: unjuran impulse Head→Under, diukur dari QML ──
    if showFiboTP
        float rng = ndir == 1 ? (nhead - nunder) : (nunder - nhead)
        if rng > 0
            string fibClean = str.replace_all(fibStr, " ", "")
            array<string> parts = str.split(fibClean, ",")
            for i = 0 to array.size(parts) - 1
                float r = str.tonumber(array.get(parts, i))
                if not na(r)
                    float tpLvl = ndir == 1 ? nqml - rng * r : nqml + rng * r
                    array.push(allLines, line.new(nlsBar, tpLvl, bar_index + 1, tpLvl, extend=extB, color=color.new(fibColor, 55), style=line.style_dotted, width=1))
                    if fibLabels
                        array.push(allLabels, label.new(bar_index, tpLvl, str.tostring(r, "#.###"), style=label.style_label_left, color=color.new(fibColor, 40), textcolor=color.white, size=size.tiny))

    array.push(setLineCounts, array.size(allLines) - lineStart)
    array.push(setLabelCounts, array.size(allLabels) - labelStart)
    pruneSets()

// ─────────────────── ENTRY / RESOLVE ───────────────────
bool firedSell = false
bool firedBuy  = false

// Tambah label pada set AKTIF supaya ia dipadam bersama set (elak bertimbun)
addLabel(label lb) =>
    array.push(allLabels, lb)
    if array.size(setLabelCounts) > 0
        array.set(setLabelCounts, array.size(setLabelCounts) - 1,
                  array.get(setLabelCounts, array.size(setLabelCounts) - 1) + 1)

if armed
    bool expired = bar_index - armTime > armMaxBars

    if armDir == 1
        if close > armHead or expired
            array.push(qmlHist, armQML)
            while array.size(qmlHist) > 20
                array.shift(qmlHist)
            lastQML := armQML
            lastDoneUnder := armUnderBar
            armed := false
        else if bar_index > armTime and high >= armQML
            firedSell := true
            if showEntry
                addLabel(label.new(bar_index, high,
                     (armConfluence ? "SELL @ QML ★" : "SELL @ QML") + "\n" + str.tostring(armQML, format.mintick),
                     style=label.style_label_down, color=bearColor, textcolor=color.white, size=size.small))
            if showTP
                addLabel(label.new(bar_index, armNeck, "TP1 " + str.tostring(armNeck, format.mintick), style=label.style_label_left, color=color.new(bearColor, 25), textcolor=color.white, size=size.tiny))
                addLabel(label.new(bar_index, armUnder, "TP2 " + str.tostring(armUnder, format.mintick), style=label.style_label_left, color=color.new(bearColor, 25), textcolor=color.white, size=size.tiny))
            array.push(qmlHist, armQML)
            while array.size(qmlHist) > 20
                array.shift(qmlHist)
            lastQML := armQML
            lastDoneUnder := armUnderBar
            armed := false
    else
        if close < armHead or expired
            array.push(qmlHist, armQML)
            while array.size(qmlHist) > 20
                array.shift(qmlHist)
            lastQML := armQML
            lastDoneUnder := armUnderBar
            armed := false
        else if bar_index > armTime and low <= armQML
            firedBuy := true
            if showEntry
                addLabel(label.new(bar_index, low,
                     (armConfluence ? "BUY @ QML ★" : "BUY @ QML") + "\n" + str.tostring(armQML, format.mintick),
                     style=label.style_label_up, color=bullColor, textcolor=color.white, size=size.small))
            if showTP
                addLabel(label.new(bar_index, armNeck, "TP1 " + str.tostring(armNeck, format.mintick), style=label.style_label_left, color=color.new(bullColor, 25), textcolor=color.white, size=size.tiny))
                addLabel(label.new(bar_index, armUnder, "TP2 " + str.tostring(armUnder, format.mintick), style=label.style_label_left, color=color.new(bullColor, 25), textcolor=color.white, size=size.tiny))
            array.push(qmlHist, armQML)
            while array.size(qmlHist) > 20
                array.shift(qmlHist)
            lastQML := armQML
            lastDoneUnder := armUnderBar
            armed := false

plotshape(firedSell, title="Bearish QM (SELL)", style=shape.triangledown, location=location.abovebar, color=bearColor, size=size.tiny)
plotshape(firedBuy,  title="Bullish QM (BUY)",  style=shape.triangleup,   location=location.belowbar, color=bullColor, size=size.tiny)

// ─────────────────────────── PANEL ───────────────────────────
var table panel = table.new(position.top_right, 2, 7, border_width=1, border_color=color.new(color.gray, 60))

if showPanel and barstate.islast
    color hdr = armed ? (armDir == 1 ? bearColor : bullColor) : color.new(color.gray, 20)
    table.cell(panel, 0, 0, "QM MASTER", bgcolor=color.new(color.black, 20), text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 0, armed ? (armDir == 1 ? "SELL ARMED" : "BUY ARMED") : "TIADA SETUP", bgcolor=hdr, text_color=color.white, text_size=size.small)

    table.cell(panel, 0, 1, "Entry (QML)", bgcolor=color.new(color.black, 60), text_color=color.silver, text_size=size.tiny)
    table.cell(panel, 1, 1, armed ? str.tostring(armQML, format.mintick) : "—", bgcolor=color.new(color.black, 60), text_color=color.white, text_size=size.tiny)

    table.cell(panel, 0, 2, "SL (Head)", bgcolor=color.new(color.black, 60), text_color=color.silver, text_size=size.tiny)
    table.cell(panel, 1, 2, armed ? str.tostring(armHead, format.mintick) : "—", bgcolor=color.new(color.black, 60), text_color=color.white, text_size=size.tiny)

    table.cell(panel, 0, 3, "TP1 (Neck)", bgcolor=color.new(color.black, 60), text_color=color.silver, text_size=size.tiny)
    table.cell(panel, 1, 3, armed ? str.tostring(armNeck, format.mintick) : "—", bgcolor=color.new(color.black, 60), text_color=color.white, text_size=size.tiny)

    table.cell(panel, 0, 4, "TP2 (Under)", bgcolor=color.new(color.black, 60), text_color=color.silver, text_size=size.tiny)
    table.cell(panel, 1, 4, armed ? str.tostring(armUnder, format.mintick) : "—", bgcolor=color.new(color.black, 60), text_color=color.white, text_size=size.tiny)

    table.cell(panel, 0, 5, "Confluence", bgcolor=color.new(color.black, 60), text_color=color.silver, text_size=size.tiny)
    table.cell(panel, 1, 5, armed ? (armConfluence ? "YA ★" : "TIDAK") : "—", bgcolor=color.new(color.black, 60), text_color=armed and armConfluence ? color.orange : color.white, text_size=size.tiny)

    table.cell(panel, 0, 6, "RR (TP1)", bgcolor=color.new(color.black, 60), text_color=color.silver, text_size=size.tiny)
    float rr = armed and math.abs(armQML - armHead) > 0 ? math.abs(armNeck - armQML) / math.abs(armQML - armHead) : na
    table.cell(panel, 1, 6, na(rr) ? "—" : str.tostring(rr, "#.##"), bgcolor=color.new(color.black, 60), text_color=color.white, text_size=size.tiny)

// ─────────────────────────── ALERT ───────────────────────────
alertcondition(firedSell, "Bearish QM (SELL)", "Quasimodo Over & Under — SELL di QML (aras bahu kiri)")
alertcondition(firedBuy,  "Bullish QM (BUY)",  "Quasimodo Over & Under — BUY di QML (aras bahu kiri)")
